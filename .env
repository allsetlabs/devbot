# DevBot Environment Variables
# Dynamic vars (API_KEY, VITE_API_KEY, DEVBOT_PROJECTS_DIR, BACKEND_PORT,
# BACKEND_HOST, VITE_BACKEND_PORT, VITE_DEVBOT_PROJECTS_DIR) are injected
# by `make start` as environment variables — not written to this file.

# Auth kill switch (dev only) — true = bypass Google OAuth AND the API key
# check entirely; every request runs as a dev user. Set to false (or remove)
# before exposing DevBot outside localhost / the tunnel.
DISABLE_AUTH=true

# Google OAuth (optional — if not set, falls back to API key auth)
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Add redirect URI: https://<your-host>:3100/auth/google/callback
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
#ALLOWED_EMAIL=subbiah2806@gmail.com

# SQLite Database Paths
DB_CORE_PATH=~/.devbot/devbot.db
DB_BABY_LOGS_PATH=~/.devbot/baby-logs.db
DB_LAWN_CARE_PATH=~/.devbot/lawn-care.db

# Terminal port ranges
XTERM_BASE_PORT=7750
XTERM_MAX_PORT=7799

# Cloudflare Tunnel (optional — managed via Settings page or make tunnel-start)
# For named tunnels with custom domains, get a token from:
# https://one.dash.cloudflare.com/networks/tunnels
# Add a Cloudflare Access policy with Google OAuth for zero-trust protection.
#CLOUDFLARE_TUNNEL_TOKEN=
