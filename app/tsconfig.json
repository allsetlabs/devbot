{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "types": ["vite/client"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@allsetlabs/forge/*": ["../../forge/src/*"],
      "@devbot/app/*": ["./src/*"],
      "@devbot/plugin-baby-logs/frontend/*": ["../plugins/baby-logs/frontend/*"],
      "@devbot/plugin-family-hierarchy/frontend/*": ["../plugins/family-hierarchy/frontend/*"],
      "@devbot/plugin-baby-logs/backend/*": ["../plugins/baby-logs/backend/*"],
      "@devbot/plugin-lawn-care/frontend/*": ["../plugins/lawn-care/frontend/*"],
      "@devbot/plugin-lawn-care/backend/*": ["../plugins/lawn-care/backend/*"],
      "@devbot/plugin-trip-planner/frontend/*": ["../plugins/trip-planner/frontend/*"],
      "@devbot/plugin-trip-planner/backend/*": ["../plugins/trip-planner/backend/*"],
      "@devbot/plugin-baby-monitor/frontend/*": ["../plugins/baby-monitor/frontend/*"],
      "@devbot/plugin-baby-monitor/backend/*": ["../plugins/baby-monitor/backend/*"],
      "@devbot/plugin-personal-finance/frontend/*": ["../plugins/personal-finance/frontend/*"],
      "@devbot/plugin-personal-finance/backend/*": ["../plugins/personal-finance/backend/*"],
      "@devbot/plugin-deep-research/frontend/*": ["../plugins/deep-research/frontend/*"],
      "@devbot/plugin-deep-research/backend/*": ["../plugins/deep-research/backend/*"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
